{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tikvideo",
  "main": "worker/seo-entry.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/ar/",
      "/robots.txt",
      "/about.html",
      "/privacy.html",
      "/terms.html",
      "/copyright.html",
      "/contact.html"
    ]
  }
}